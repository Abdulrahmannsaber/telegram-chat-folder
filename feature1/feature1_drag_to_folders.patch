+        animator.addUpdateListener(valueAnimator -> {
+            folderDragBackdropProgress = (float) valueAnimator.getAnimatedValue();
+            if (fragmentView != null) {
+                fragmentView.invalidate();
+            }
+        });
+        animator.addListener(new AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(Animator animation) {
+                if (folderDragBackdropAnimator != animation) {
+                    return;
+                }
+                folderDragBackdropAnimator = null;
+                if (!show) {
+                    folderDragBackdropProgress = 0f;
+                    recycleFolderDragBackdrop();
+                }
+            }
