+    private MessagesController.DialogFilter findFolderActionFilter(int filterId) {
+        for (MessagesController.DialogFilter filter : getMessagesController().getDialogFilters()) {
+            if (filter.id == filterId && !filter.isDefault()) {
+                return filter;
+            }
+        }
+        return null;
+    }
+
+    private void showFolderActionSheet() {
+        if (folderActionInProgress || selectedDialogs.isEmpty() || getParentActivity() == null) {
+            return;
+        }
+        final ArrayList<Long> dialogs = new ArrayList<>(selectedDialogs);
+        FiltersListBottomSheet sheet = new FiltersListBottomSheet(this, dialogs);
+        sheet.setActionDelegate((targetId, secondary) -> applyFolderAction(dialogs, targetId, secondary));
+        showDialog(sheet);
+    }
+
+    private boolean checkFolderActionLimit(MessagesController.DialogFilter filter, int included, int excluded) {
+        if (filter.locked) {
+            showDialog(new LimitReachedBottomSheet(this, getContext(), LimitReachedBottomSheet.TYPE_FOLDERS, currentAccount, null));
+            return false;
+        }
+        int limit = getUserConfig().isPremium() ? getMessagesController().dialogFiltersChatsLimitPremium : getMessagesController().dialogFiltersChatsLimitDefault;
+        if (included > limit) {
+            showDialog(new LimitReachedBottomSheet(this, getContext(), LimitReachedBottomSheet.TYPE_CHATS_IN_FOLDER, currentAccount, null));
+            return false;
+        }
+        if (excluded > 100) {
+            showDialog(AlertsCreator.createSimpleAlert(getParentActivity(), LocaleController.getString(R.string.FilterAddToAlertFullTitle), LocaleController.getString(R.string.FilterAddToAlertFullText)).create());
+            return false;
+        }
+        return true;
+    }
+
+    private LongSparseIntArray copyFolderActionPins(LongSparseIntArray source) {
+        LongSparseIntArray result = new LongSparseIntArray();
+        for (int i = 0; i < source.size(); i++) {
+            result.put(source.keyAt(i), source.valueAt(i));
+        }
+        return result;
+    }
+
+    private class FolderMembershipState {
+        final int filterId;
+        final ArrayList<Long> dialogs;
+        final ArrayList<Long> included = new ArrayList<>();
+        final ArrayList<Long> excluded = new ArrayList<>();
+        final LongSparseIntArray pinned = new LongSparseIntArray();
+
+        FolderMembershipState(MessagesController.DialogFilter filter, ArrayList<Long> dialogs) {
+            filterId = filter.id;
+            this.dialogs = new ArrayList<>(dialogs);
+            for (long did : dialogs) {
+                if (filter.alwaysShow.contains(did)) {
+                    included.add(did);
+                }
+                if (filter.neverShow.contains(did)) {
+                    excluded.add(did);
+                }
+                int pinIndex = filter.pinnedDialogs.indexOfKey(did);
+                if (pinIndex >= 0) {
+                    pinned.put(did, filter.pinnedDialogs.valueAt(pinIndex));
+                }
+            }
+        }
+
+        void restore(Utilities.Callback<Boolean> onResult) {
+            MessagesController.DialogFilter filter = findFolderActionFilter(filterId);
+            if (filter == null || filter.locked) {
+                onResult.run(false);
+                return;
+            }
+            ArrayList<Long> alwaysShow = new ArrayList<>(filter.alwaysShow);
+            ArrayList<Long> neverShow = new ArrayList<>(filter.neverShow);
+            LongSparseIntArray pins = copyFolderActionPins(filter.pinnedDialogs);
+            for (long did : dialogs) {
+                alwaysShow.remove(did);
+                neverShow.remove(did);
+                pins.delete(did);
+            }
+            alwaysShow.addAll(included);
+            neverShow.addAll(excluded);
+            for (int i = 0; i < pinned.size(); i++) {
+                pins.put(pinned.keyAt(i), pinned.valueAt(i));
+            }
+            if (!checkFolderActionLimit(filter, alwaysShow.size(), neverShow.size())) {
+                onResult.run(false);
+                return;
+            }
+            FilterCreateActivity.saveFilterToServerWithResult(filter, alwaysShow, neverShow, pins, DialogsActivity.this, onResult);
+        }
+    }
+
+    private void showFolderActionError(int textId) {
+        if (getParentActivity() != null && fragmentView != null) {
+            BulletinFactory.of(this).createErrorBulletin(LocaleController.getString(textId)).show();
+        }
+    }
+
+    private int folderActionSaveErrorText(TLRPC.TL_error error) {
+        if (error != null) {
+            if ("DIALOG_FILTERS_TOO_MUCH".equals(error.text)) {
+                return R.string.FolderActionFoldersLimit;
+            }
+            if ("FILTER_INCLUDE_EMPTY".equals(error.text)) {
+                return R.string.FolderActionEmpty;
+            }
+            if ("FILTER_ID_INVALID".equals(error.text)) {
+                return R.string.FolderActionTargetMissing;
+            }
+        }
+        return R.string.FolderActionFailed;
+    }
+
+    private void applyFolderAction(ArrayList<Long> dialogs, int targetId, boolean archiveAfter) {
+        if (folderActionInProgress || getParentActivity() == null) {
+            return;
+        }
+        MessagesController.DialogFilter target = findFolderActionFilter(targetId);
+        if (target == null) {
+            showFolderActionError(R.string.FolderActionTargetMissing);
+            return;
+        }
+        final ArrayList<Long> peers = new ArrayList<>();
+        for (long did : FiltersListBottomSheet.getDialogsCount(this, null, dialogs, true, false)) {
+            if (!peers.contains(did)) {
+                peers.add(did);
+            }
+        }
+        if (peers.isEmpty()) {
+            return;
+        }
+        ArrayList<Long> included = new ArrayList<>(target.alwaysShow);
+        ArrayList<Long> excluded = new ArrayList<>(target.neverShow);
+        for (long did : peers) {
+            excluded.remove(did);
+            if (!included.contains(did)) {
+                included.add(did);
+            }
+        }
+        if (!checkFolderActionLimit(target, included.size(), excluded.size())) {
+            return;
+        }
+        final ArrayList<Long> stateDialogs = new ArrayList<>(peers);
+        for (long did : dialogs) {
+            if (!stateDialogs.contains(did)) {
+                stateDialogs.add(did);
+            }
+        }
+        final FolderMembershipState targetState = new FolderMembershipState(target, stateDialogs);
+        final CharSequence targetName = target.name;
+        folderActionInProgress = true;
+        hideActionMode(true);
+        Utilities.Callback2<Boolean, TLRPC.TL_error> afterTarget = (success, error) -> {
+            if (!success) {
+                folderActionInProgress = false;
+                showFolderActionError(folderActionSaveErrorText(error));
+                return;
+            }
+            LongSparseIntArray archivedPins = new LongSparseIntArray();
+            boolean archiveSkipped = false;
+            if (archiveAfter) {
+                ArrayList<Long> toArchive = new ArrayList<>();
+                for (long did : dialogs) {
+                    TLRPC.Dialog dialog = getMessagesController().dialogs_dict.get(did);
+                    if (dialog == null || dialog.folder_id != 0) {
+                        continue;
+                    }
+                    if (did == getUserConfig().getClientUserId() || did == 777000 || getMessagesController().isPromoDialog(did, false)
+                            || ChatObject.isCommunity(getMessagesController().getChat(-did))) {
+                        archiveSkipped = true;
+                        continue;
+                    }
+                    archivedPins.put(did, dialog.pinned ? dialog.pinnedNum : 0);
+                    toArchive.add(did);
+                }
+                if (!toArchive.isEmpty()) {
+                    getMessagesController().addDialogToFolder(toArchive, 1, -1, null, 0);
+                }
+            }
+            int textId = archiveAfter
+                    ? archiveSkipped ? R.string.FolderArchiveSkipped : R.string.FolderActionArchived : R.string.FolderActionAdded;
+            finishFolderAction(textId, targetName, targetState, archivedPins);
+
+        };
+        if (included.equals(target.alwaysShow) && excluded.equals(target.neverShow)) {
+            afterTarget.run(true, null);
+        } else {
+            FilterCreateActivity.saveFilterToServerWithError(target, included, excluded, copyFolderActionPins(target.pinnedDialogs), this, afterTarget);
+        }
+    }
+
+    private void finishFolderAction(int textId, CharSequence targetName, FolderMembershipState target, LongSparseIntArray archivedPins) {
+        folderActionInProgress = false;
+        if (getParentActivity() == null || fragmentView == null) {
+            return;
+        }
+        CharSequence text = LocaleController.formatString(textId, targetName);
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.folder_in, text, LocaleController.getString(R.string.Undo), 5000,
+                () -> undoFolderAction(target, archivedPins)).show();
+    }
+
+    private void undoFolderAction(FolderMembershipState target, LongSparseIntArray archivedPins) {
+        if (folderActionInProgress) {
+            showFolderActionError(R.string.FolderUndoBusy);
+            return;
+        }
+        folderActionInProgress = true;
+        target.restore(targetRestored -> {
+            folderActionInProgress = false;
+            if (!targetRestored) {
+                showFolderActionError(R.string.FolderUndoFailed);
+                return;
+            }
+            for (int i = 0; i < archivedPins.size(); i++) {
+                long did = archivedPins.keyAt(i);
+                TLRPC.Dialog dialog = getMessagesController().dialogs_dict.get(did);
+                if (dialog != null && dialog.folder_id == 1) {
+                    getMessagesController().addDialogToFolder(did, 0, archivedPins.valueAt(i), 0);
+                }
+            }
+        });
+    }
