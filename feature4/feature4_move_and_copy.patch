+    private void applyFolderAction(ArrayList<Long> dialogs, int sourceId, int targetId, boolean secondary) {
+        if (folderActionInProgress || getParentActivity() == null) {
+            return;
+        }
+        final boolean move = !secondary;
+        MessagesController.DialogFilter target = findFolderActionFilter(targetId);
+        MessagesController.DialogFilter source = findFolderActionFilter(sourceId);
+        if (target == null || targetId == sourceId) {
+            showFolderActionError(R.string.FolderActionTargetMissing);
+            return;
+        }
+        if (source == null) {
+            showFolderActionError(R.string.FolderActionSourceMissing);
+            return;
+        }
+        final ArrayList<Long> peers = new ArrayList<>();
+        for (long did : FiltersListBottomSheet.getDialogsCount(this, null, dialogs, true, false)) {
+            if (!peers.contains(did)) {
+                peers.add(did);
+            }
+        }
+        if (peers.isEmpty()) {
+            return;
+        }
+        ArrayList<Long> included = new ArrayList<>(target.alwaysShow);
+        ArrayList<Long> excluded = new ArrayList<>(target.neverShow);
+        for (long did : peers) {
+            excluded.remove(did);
+            if (!included.contains(did)) {
+                included.add(did);
+            }
+        }
+        if (!checkFolderActionLimit(target, included.size(), excluded.size())) {
+            return;
+        }
+        if (move) {
+            if (!canRemoveFolderActionDialogs(source, peers)) {
+                showFolderActionError(R.string.FolderMoveEmptySource);
+                return;
+            }
+            ArrayList<Long> sourceExcluded = new ArrayList<>(source.neverShow);
+            for (long did : peers) {
+                if (!source.isChatlist() && !sourceExcluded.contains(did)) {
+                    sourceExcluded.add(did);
+                }
+            }
+            if (!checkFolderActionLimit(source, source.alwaysShow.size(), sourceExcluded.size())) {
+                return;
+            }
+        }
+        final ArrayList<Long> stateDialogs = new ArrayList<>(peers);
+        for (long did : dialogs) {
+            if (!stateDialogs.contains(did)) {
+                stateDialogs.add(did);
+            }
+        }
+        final FolderMembershipState targetState = new FolderMembershipState(target, stateDialogs);
+        final CharSequence targetName = target.name;
+        folderActionInProgress = true;
+        hideActionMode(true);
+        Utilities.Callback2<Boolean, TLRPC.TL_error> afterTarget = (success, error) -> {
+            if (!success) {
+                folderActionInProgress = false;
+                showFolderActionError(folderActionSaveErrorText(error));
+                return;
+            }
+            if (move) {
+                removeFolderActionSource(stateDialogs, peers, sourceId, targetState, targetName);
+            } else {
+                finishFolderAction(R.string.FolderActionCopied, targetName, targetState, null);
+            }
+        };
+        if (included.equals(target.alwaysShow) && excluded.equals(target.neverShow)) {
+            afterTarget.run(true, null);
+        } else {
+            FilterCreateActivity.saveFilterToServerWithError(target, included, excluded, copyFolderActionPins(target.pinnedDialogs), this, afterTarget);
+        }
+    }
+
+    private void removeFolderActionSource(ArrayList<Long> dialogs, ArrayList<Long> peers, int sourceId, FolderMembershipState targetState, CharSequence targetName) {
+        MessagesController.DialogFilter source = findFolderActionFilter(sourceId);
+        if (source == null || source.locked) {
+            finishFolderAction(R.string.FolderMovePartial, targetName, targetState, null);
+            return;
+        }
+        if (!canRemoveFolderActionDialogs(source, peers)) {
+            finishFolderAction(R.string.FolderMovePartial, targetName, targetState, null);
+            return;
+        }
+        FolderMembershipState sourceState = new FolderMembershipState(source, dialogs);
+        ArrayList<Long> included = new ArrayList<>(source.alwaysShow);
+        ArrayList<Long> excluded = new ArrayList<>(source.neverShow);
+        LongSparseIntArray pins = copyFolderActionPins(source.pinnedDialogs);
+        for (long did : dialogs) {
+            pins.delete(did);
+        }
+        for (long did : peers) {
+            included.remove(did);
+            pins.delete(did);
+            if (!source.isChatlist() && !excluded.contains(did)) {
+                excluded.add(did);
+            }
+        }
+        if (!checkFolderActionLimit(source, included.size(), excluded.size())) {
+            finishFolderAction(R.string.FolderMovePartial, targetName, targetState, null);
+            return;
+        }
+        FilterCreateActivity.saveFilterToServerWithResult(source, included, excluded, pins, this, success ->
+                finishFolderAction(success ? R.string.FolderActionMoved : R.string.FolderMovePartial, targetName, targetState, success ? sourceState : null));
+    }
+
+    private void finishFolderAction(int textId, CharSequence targetName, FolderMembershipState target, FolderMembershipState source) {
+        folderActionInProgress = false;
+        if (getParentActivity() == null || fragmentView == null) {
+            return;
+        }
+        CharSequence text = textId == R.string.FolderMovePartial ? LocaleController.getString(textId) : LocaleController.formatString(textId, targetName);
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.folder_in, text, LocaleController.getString(R.string.Undo), 5000,
+                () -> undoFolderAction(target, source)).show();
+    }
+
+    private void undoFolderAction(FolderMembershipState target, FolderMembershipState source) {
+        if (folderActionInProgress) {
+            showFolderActionError(R.string.FolderUndoBusy);
+            return;
+        }
+        folderActionInProgress = true;
+        Utilities.Callback<Boolean> restoreTarget = sourceRestored -> {
+            if (!sourceRestored) {
+                folderActionInProgress = false;
+                showFolderActionError(R.string.FolderUndoFailed);
+                return;
+            }
+            target.restore(targetRestored -> {
+                folderActionInProgress = false;
+                if (!targetRestored) {
+                    showFolderActionError(R.string.FolderUndoFailed);
+                    return;
+                }
+            });
+        };
+        if (source != null) {
+            source.restore(restoreTarget);
+        } else {
+            restoreTarget.run(true);
+        }
+    }
