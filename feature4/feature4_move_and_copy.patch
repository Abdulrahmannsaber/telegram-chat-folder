+    private boolean checkFolderActionLimit(MessagesController.DialogFilter filter, int included, int excluded) {
+        if (filter.locked) {
+            showDialog(new LimitReachedBottomSheet(this, getContext(), LimitReachedBottomSheet.TYPE_FOLDERS, currentAccount, null));
+            return false;
+        }
+        int limit = getUserConfig().isPremium() ? getMessagesController().dialogFiltersChatsLimitPremium : getMessagesController().dialogFiltersChatsLimitDefault;
+        if (included > limit) {
+            showDialog(new LimitReachedBottomSheet(this, getContext(), LimitReachedBottomSheet.TYPE_CHATS_IN_FOLDER, currentAccount, null));
+            return false;
+        }
+        if (excluded > 100) {
+            showDialog(AlertsCreator.createSimpleAlert(getParentActivity(), LocaleController.getString(R.string.FilterAddToAlertFullTitle), LocaleController.getString(R.string.FilterAddToAlertFullText)).create());
+            return false;
+        }
+        return true;
+    }
+
+    private boolean canRemoveFolderActionDialogs(MessagesController.DialogFilter filter, ArrayList<Long> peers) {
+        if (!filter.isChatlist() && (filter.flags & MessagesController.DIALOG_FILTER_FLAG_ALL_CHATS) != 0) {
+            return true;
+        }
+        for (long did : filter.alwaysShow) {
+            if (!peers.contains(did)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private LongSparseIntArray copyFolderActionPins(LongSparseIntArray source) {
+        LongSparseIntArray result = new LongSparseIntArray();
+        for (int i = 0; i < source.size(); i++) {
+            result.put(source.keyAt(i), source.valueAt(i));
+        }
+        return result;
+    }
+
+    private class FolderMembershipState {
+        final int filterId;
+        final ArrayList<Long> dialogs;
+        final ArrayList<Long> included = new ArrayList<>();
+        final ArrayList<Long> excluded = new ArrayList<>();
+        final LongSparseIntArray pinned = new LongSparseIntArray();
+
+        FolderMembershipState(MessagesController.DialogFilter filter, ArrayList<Long> dialogs) {
+            filterId = filter.id;
+            this.dialogs = new ArrayList<>(dialogs);
+            for (long did : dialogs) {
+                if (filter.alwaysShow.contains(did)) {
+                    included.add(did);
+                }
+                if (filter.neverShow.contains(did)) {
+                    excluded.add(did);
+                }
+                int pinIndex = filter.pinnedDialogs.indexOfKey(did);
+                if (pinIndex >= 0) {
+                    pinned.put(did, filter.pinnedDialogs.valueAt(pinIndex));
+                }
+            }
+        }
+
+        void restore(Utilities.Callback<Boolean> onResult) {
+            MessagesController.DialogFilter filter = findFolderActionFilter(filterId);
+            if (filter == null || filter.locked) {
+                onResult.run(false);
+                return;
+            }
+            ArrayList<Long> alwaysShow = new ArrayList<>(filter.alwaysShow);
+            ArrayList<Long> neverShow = new ArrayList<>(filter.neverShow);
+            LongSparseIntArray pins = copyFolderActionPins(filter.pinnedDialogs);
+            for (long did : dialogs) {
+                alwaysShow.remove(did);
+                neverShow.remove(did);
+                pins.delete(did);
+            }
+            alwaysShow.addAll(included);
+            neverShow.addAll(excluded);
+            for (int i = 0; i < pinned.size(); i++) {
+                pins.put(pinned.keyAt(i), pinned.valueAt(i));
+            }
+            if (!checkFolderActionLimit(filter, alwaysShow.size(), neverShow.size())) {
+                onResult.run(false);
+                return;
+            }
+            FilterCreateActivity.saveFilterToServerWithResult(filter, alwaysShow, neverShow, pins, DialogsActivity.this, onResult);
+        }
+    }
